# ============================================
# BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env for local dev
# ============================================

# Google Sheets
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json

# JWT (ganti dengan key acak yang panjang untuk production)
JWT_SECRET_KEY=ubah-ini-dengan-key-acak-yang-sangat-panjang
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_TITLE=Pencatatan Keuangan Pribadi
APP_VERSION=1.0.0

# Untuk dev: CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Untuk production: CORS_ORIGINS=["https://namafrontend.vercel.app"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Cache
CACHE_TTL=300

# Telegram (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BACKEND_URL=

# Gemini AI (opsional)
GEMINI_API_KEY=
